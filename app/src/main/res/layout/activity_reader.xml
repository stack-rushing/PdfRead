<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_background">

    <!--
      手势层：只包住阅读区（不含顶/底控制面板）。
      dispatchTouchEvent 里用 GestureDetector 只做"观察"、不消费事件，
      因此不会干扰 ViewPager2 的横滑，也不会抢走子 View 的点击。
    -->
    <com.novelreader.pdf.ui.widget.TapZoneLayout
        android:id="@+id/tapZone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/reader_background" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_primary" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="96dp"
            android:text="@string/reader_loading"
            android:textColor="@color/panel_text_secondary"
            android:textSize="13sp" />
    </com.novelreader.pdf.ui.widget.TapZoneLayout>

    <!-- 错误兜底面板 -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@color/panel_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reader_error_title"
            android:textColor="@color/panel_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/panel_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reader_menu_retry" />
    </LinearLayout>

    <!-- 目录生成任务进度（OCR 可能要一两分钟，必须看得见、能取消） -->
    <LinearLayout
        android:id="@+id/tocPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:background="@color/panel_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/tocProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:max="100"
            app:trackCornerRadius="3dp"
            app:trackThickness="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tocText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/panel_text_secondary"
                android:textSize="12sp"
                tools:text="OCR 识别页眉… 120/2278 (5%)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTocCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/reader_cancel" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 顶部标题栏 ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/panel_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.NovelReader.PanelIcon"
            android:contentDescription="@string/reader_back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/panel_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="1 这宗案件开始了" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/panel_text_secondary"
                android:textSize="11sp"
                tools:text="书虫·牛津英汉双语读物（第4级上） › 巴斯克维尔猎犬 › 1 The Case Begins"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNightMode"
            style="@style/Widget.NovelReader.PanelIcon"
            android:contentDescription="@string/reader_night_mode"
            android:src="@drawable/ic_night_mode" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Widget.NovelReader.PanelIcon"
            android:contentDescription="@string/reader_more"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- ================= 底部控制面板 ================= -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel_background"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/panel_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvChapterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/panel_text"
                android:textSize="13sp"
                tools:text="1 这宗案件开始了" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/panel_text_secondary"
                android:textSize="13sp"
                tools:text="21 / 2278 · 0%" />

            <ImageButton
                android:id="@+id/btnToc"
                style="@style/Widget.NovelReader.PanelIcon"
                android:contentDescription="@string/reader_toc"
                android:src="@drawable/ic_toc" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnPrevChapter"
                style="@style/Widget.NovelReader.PanelIcon"
                android:contentDescription="@string/reader_prev_chapter"
                android:src="@drawable/ic_chevron_left" />

            <ImageButton
                android:id="@+id/btnPrevPage"
                style="@style/Widget.NovelReader.PanelIcon"
                android:contentDescription="@string/reader_prev_page"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                android:id="@+id/btnNextPage"
                style="@style/Widget.NovelReader.PanelIcon"
                android:contentDescription="@string/reader_next_page"
                android:src="@drawable/ic_arrow_forward" />

            <ImageButton
                android:id="@+id/btnNextChapter"
                style="@style/Widget.NovelReader.PanelIcon"
                android:contentDescription="@string/reader_next_chapter"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
